# Copie este arquivo para ".env" na raiz do projeto e preencha com suas credenciais.
# O docker-compose.yml carrega essas variáveis automaticamente do .env.

# Chave do recurso "Speech" no Azure Portal (obrigatório)
AZURE_SPEECH_KEY=

# Região do recurso Azure Speech, ex.: brazilsouth, eastus (use isto OU AZURE_ENDPOINT abaixo)
AZURE_SPEECH_REGION=

# Endpoint customizado do recurso Azure Speech (alternativa a AZURE_SPEECH_REGION)
AZURE_ENDPOINT=

# Voz usada na geração do áudio (opcional, default: pt-BR-ThalitaMultilingualNeural)
AZURE_SPEECH_VOICE=

# Ativa a narração via SSML (pausas em §/Parágrafo único/CAPÍTULO-TÍTULO-SEÇÃO,
# em vez de texto puro). Opcional, default: false. Recomendado testar manualmente
# com uma chave Azure real antes de ligar em produção — ver README.
AZURE_SPEECH_USE_SSML=

# Ajuste de velocidade da narração quando AZURE_SPEECH_USE_SSML=true, ex.: -8%
# (aceita valores como "-10%", "+5%" ou palavras como "slow"). Opcional — sem
# valor, a narração usa a velocidade padrão da voz.
AZURE_SPEECH_RATE=
